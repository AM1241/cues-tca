# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/.vite/

# Environment — never commit keys.
# The publishable/anon key is safe in a bundle but not in git history;
# the secret (service role) key must only ever live in `supabase secrets set`.
.env
.env.*
!.env.example

# Supabase local stack
supabase/.branches/
supabase/.temp/
supabase/.env

# Netlify
.netlify/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
