# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/.vite/

# Environment — never commit keys.
# The publishable/anon key is safe in a bundle but not in git history;
# the secret (service role) key must only ever live in `supabase secrets set`.
.env
.env.*
!.env.example

# Supabase local stack
supabase/.branches/
supabase/.temp/
supabase/.env

# Netlify
.netlify/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Legacy migration artefacts — real post content, reproducible via scripts/README.md
legacy_snapshot.db
legacy_posts.db
legacy_dump.sql
load_legacy.sql

# Local-only Edge Function test secrets
supabase/functions/.env*
!supabase/functions/.env.example
