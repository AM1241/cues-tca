# Edge Function environment. Copy to .env.test for local `functions serve`.
# .env* is gitignored here; real values go to Supabase with `supabase secrets set`.

# RapidAPI (Fresh LinkedIn Profile Data). Required.
# Use a dummy value locally so a stray call fails loudly instead of silently
# spending quota.
RAPIDAPI_KEY=dummy-never-used-in-tests

# Optional. Defaults to fresh-linkedin-profile-data.p.rapidapi.com.
# Not sensitive; configurable so a provider swap is not a code change.
# RAPIDAPI_HOST=fresh-linkedin-profile-data.p.rapidapi.com

# Credential for INTERNAL callers only (pg_cron, backfill), sent in the
# `apikey` header. Generate a long random value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This is NOT the service-role key. The service-role key builds the internal
# database client and is never accepted as a caller credential — a leaked one
# must not become a way to spend provider quota.
INGEST_INTERNAL_SECRET=change-me-per-environment

# Comma-separated CORS allowlist. No wildcard is ever emitted.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
